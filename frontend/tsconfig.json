{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "es2020"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"]
}
