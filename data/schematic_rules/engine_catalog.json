{
  "version": "1",
  "rules": [
    {
      "rule_id": "PWR-001",
      "name": "高压电源连接到不耐受该电压的引脚",
      "category": "power",
      "description": "比较引脚开路直流电压和绝对最大额定值或电压域。",
      "default_severity": "critical",
      "required_inputs": [
        "netlist"
      ],
      "preconditions": [
        "存在 GPIO、普通 IO 或同类引脚"
      ],
      "check_method": "PWR-001",
      "evidence_required": [
        "网络",
        "元件",
        "引脚"
      ],
      "suggested_fix": "断开高压直流偏置，或改用额定电压匹配的电平转换。",
      "confidence_policy": "没有绝对最大额定值时记为 needs_review，不认定器件损坏。装配不明或按直流短路估计时从 confirmed 降为 probable。",
      "test_cases": [
        "pullup_12v",
        "divider_safe",
        "missing_rating",
        "name_only"
      ],
      "alias_of": ""
    },
    {
      "rule_id": "PWR-002",
      "name": "电源 EN 被上拉到过高的电源轨",
      "category": "power",
      "description": "只检查标明为 EN 的引脚，不因网络名里有 EN 而报警。",
      "default_severity": "critical",
      "required_inputs": [
        "netlist"
      ],
      "preconditions": [
        "存在 EN 引脚"
      ],
      "check_method": "PWR-002",
      "evidence_required": [
        "网络",
        "元件",
        "引脚"
      ],
      "suggested_fix": "把使能上拉改到该脚允许的电源，或改为开漏加合适上拉。",
      "confidence_policy": "耐压未知时待核实，不认定损坏。",
      "test_cases": [],
      "alias_of": ""
    },
    {
      "rule_id": "PWR-003",
      "name": "上拉导致灌电流超过限额",
      "category": "power",
      "description": "用戴维南等效计算拉低时的电流，再和 IOL 比较。",
      "default_severity": "high",
      "required_inputs": [
        "netlist"
      ],
      "preconditions": [],
      "check_method": "PWR-003",
      "evidence_required": [
        "网络",
        "元件",
        "引脚"
      ],
      "suggested_fix": "增大上拉电阻或降低上拉电压。",
      "confidence_policy": "VOL 未知时只给出按 0V 估算的上限，超限记为 needs_review。IOL 未知则为无法判定。",
      "test_cases": [],
      "alias_of": ""
    },
    {
      "rule_id": "PWR-004",
      "name": "不同电源域之间的反向供电路径",
